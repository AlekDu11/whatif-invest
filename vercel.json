{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build.py",
  "outputDirectory": "dist",
  "installCommand": "true",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/whatif",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/whatif/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/bubbles",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/bubbles",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/screener",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/screener",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/calendar",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/calendar",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/heatmap",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/heatmap",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/news",
      "destination": "/:lang/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/p/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/logo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}