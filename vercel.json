{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build.py",
  "outputDirectory": "dist",
  "installCommand": "true",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/whatif",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/whatif/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/bubbles",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/bubbles",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/screener",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/screener",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/calendar",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/calendar",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/heatmap",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/heatmap",
      "destination": "/:lang/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/p/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/logo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/covers/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v/:ch/:vid",
      "destination": "/api/v?ch=:ch&vid=:vid"
    },
    {
      "source": "/v/:ch",
      "destination": "/api/v?ch=:ch"
    },
    {
      "source": "/v/:ch/:vid/",
      "destination": "/api/v?ch=:ch&vid=:vid"
    },
    {
      "source": "/v/:ch/",
      "destination": "/api/v?ch=:ch"
    },
    {
      "source": "/go/:p",
      "destination": "/api/go?p=:p"
    },
    {
      "source": "/go/:p/",
      "destination": "/api/go?p=:p"
    },
    {
      "source": "/stats",
      "destination": "/api/stats"
    },
    {
      "source": "/stats/",
      "destination": "/api/stats"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
