{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build.py",
  "outputDirectory": "dist",
  "installCommand": "true",
  "framework": null,
  "trailingSlash": true,
  "functions": {
    "api/page.py": {
      "maxDuration": 10,
      "excludeFiles": "{dist,.git,.github,content/covers,content/video,social,reports,ads,partners,data/feed,src/og,node_modules}/**"
    }
  },
  "redirects": [
    {
      "source": "/tg",
      "destination": "/en/?utm_source=telegram&utm_medium=channel",
      "permanent": false
    },
    {
      "source": "/tg/:path(.*)",
      "destination": "/:path?utm_source=telegram&utm_medium=channel",
      "permanent": false
    },
    {
      "source": "/whatif",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/whatif/:path(.*)",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/bubbles",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/bubbles",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/screener",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/screener",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/calendar",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/calendar",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/heatmap",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang/heatmap",
      "destination": "/:lang/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/((?!embed/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/p/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/logo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/covers/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v/:ch/:vid",
      "destination": "/api/v?ch=:ch&vid=:vid"
    },
    {
      "source": "/v/:ch",
      "destination": "/api/v?ch=:ch"
    },
    {
      "source": "/v/:ch/:vid/",
      "destination": "/api/v?ch=:ch&vid=:vid"
    },
    {
      "source": "/v/:ch/",
      "destination": "/api/v?ch=:ch"
    },
    {
      "source": "/go/:p",
      "destination": "/api/go?p=:p"
    },
    {
      "source": "/go/:p/",
      "destination": "/api/go?p=:p"
    },
    {
      "source": "/stats",
      "destination": "/api/stats"
    },
    {
      "source": "/stats/",
      "destination": "/api/stats"
    },
    {
      "source": "/largest-companies/:p(\\d+)/",
      "destination": "/api/page?l=uk&lc=mcap&p=:p"
    },
    {
      "source": "/largest-companies/:lc(revenue|earnings|employees|dividend|pe-ratio)/:p(\\d+)/",
      "destination": "/api/page?l=uk&lc=:lc&p=:p"
    },
    {
      "source": "/:lang(en|es|pt|de|fr|it|pl|tr|nl|ru|id|vi|th|hi|ja|ko|zh|ar|fil)/largest-companies/:p(\\d+)/",
      "destination": "/api/page?l=:lang&lc=mcap&p=:p"
    },
    {
      "source": "/:lang(en|es|pt|de|fr|it|pl|tr|nl|ru|id|vi|th|hi|ja|ko|zh|ar|fil)/largest-companies/:lc(revenue|earnings|employees|dividend|pe-ratio)/:p(\\d+)/",
      "destination": "/api/page?l=:lang&lc=:lc&p=:p"
    },
    {
      "source": "/:aid([^/]+)/",
      "destination": "/api/page?l=uk&a=:aid"
    },
    {
      "source": "/:lang(en|es|pt|de|fr|it|pl|tr|nl|ru|id|vi|th|hi|ja|ko|zh|ar|fil)/:aid",
      "destination": "/api/page?l=:lang&a=:aid"
    },
    {
      "source": "/:lang(en|es|pt|de|fr|it|pl|tr|nl|ru|id|vi|th|hi|ja|ko|zh|ar|fil)/:aid/",
      "destination": "/api/page?l=:lang&a=:aid"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
